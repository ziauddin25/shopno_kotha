# Supabase configuration for Shopno Kotha.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). `.env.local` is git-ignored; this example
# file is safe to commit and must never contain real secrets.
#
# NEXT_PUBLIC_* values are exposed to the browser bundle. Never prefix a
# secret (such as the service-role key) with NEXT_PUBLIC_.

# Public site URL, used for metadata, canonical links and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase project URL and anon key (safe to expose; access is governed
# by Row Level Security policies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service-role key. Bypasses RLS. Never expose to the browser and
# never commit a real value. Used only for privileged server tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Data source for the repository layer.
#   supabase – live database (set this in production)
#   mock     – in-memory fixtures (development and tests only)
#   unset    – use Supabase when the keys above are set, otherwise fixtures
# A failed database request never falls back to fixtures: it surfaces as an
# error to the caller.
DATA_SOURCE=supabase

# Public storage bucket for article cover images.
SUPABASE_STORAGE_BUCKET=article-covers

